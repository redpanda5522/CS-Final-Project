# Copy to .env to override the docker-compose defaults. .env is ignored by Git.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=senior_project
POSTGRES_PORT=5432

# Password reset emails. Leave SMTP_HOST empty in development: reset links are then
# written to the backend log (docker-compose logs backend).
APP_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false
